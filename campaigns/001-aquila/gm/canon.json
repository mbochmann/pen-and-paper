  "facts": [
    {
      "id": "fact-setting",
      "text": "Valdora ist fiktiv und römisch geprägt; kein konkretes historisches Jahr.",
      "visibility": "public",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-diversion",
      "text": "Marcellus veranlasste eine absichtliche Umleitung ins Reservebecken, um an Notwasser und einem Folgeauftrag zu verdienen.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-spring",
      "text": "Die Morgenquelle liefert ausreichend Wasser.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-neria",
      "text": "Neria sitzt nach einem Stegbruch mit verstauchtem Knöchel im trockenen Wartungsraum fest; sie wurde nicht entführt.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-livia",
      "text": "Livia verursachte den Wasserausfall nicht. Ihre Arbeitsanweisung wurde zur falschen Schuldzuweisung verändert.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-sextus",
      "text": "Sextus erhielt Marcellus’ Auftrag, weiß zu Beginn aber nicht, dass absichtlich die Stadtversorgung gekappt wurde.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-reserves",
      "text": "Die Stadt hat Notvorräte; Zeitdruck bedeutet Versorgungskonflikt, nicht einen Todes-Countdown.",
      "visibility": "gm",
      "status": "established",
      "origin": "prepared"
    },
    {
      "id": "fact-magic",
      "text": "Im Ausgangsmodus ist keine tatsächliche Magie bestätigt.",
      "visibility": "public",
      "status": "established",
      "origin": "prepared"
    }
  ]
